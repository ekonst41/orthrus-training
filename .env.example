# Copy to .env (never committed) and fill in. scripts/ds.py passes the ORTHRUS_* values to jobs.

# DataSphere project id: open the project in DataSphere, the id is in the URL and on the project page.
DS_PROJECT_ID=

# Hugging Face token for local use (read access is enough; Nemotron-Post-Training-Dataset-v2 is
# gated: accept its terms on huggingface.co first). DataSphere jobs use the project secret HF_TOKEN,
# which needs write access to the storage bucket (see DEVELOPMENT.md).
HF_TOKEN=

# Private HF Storage Bucket for data, checkpoints and logs ("user/name"; empty: local only).
ORTHRUS_BUCKET=

# Trackio dashboard: private HF Space created on first use ("user/name"; empty: no dashboard,
# metrics still go to the bucket and to the JSONL files).
ORTHRUS_TRACKIO_SPACE=
