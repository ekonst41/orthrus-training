# Copy to .env (never committed) and fill in.

# DataSphere project id: open the project in DataSphere, the id is in the URL and on the project page.
DS_PROJECT_ID=

# Hugging Face token (read access is enough for downloads; Nemotron-Post-Training-Dataset-v2 is gated:
# accept its terms on huggingface.co first). In DataSphere jobs the same value comes from a project
# secret named HF_TOKEN.
HF_TOKEN=
