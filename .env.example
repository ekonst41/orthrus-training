# Copy to .env (never committed) and fill in.

# DataSphere project id: open the project in DataSphere, the id is in the URL and on the project page.
DS_PROJECT_ID=

# Hugging Face token for local use (read access is enough; Nemotron-Post-Training-Dataset-v2 is
# gated: accept its terms on huggingface.co first). DataSphere jobs use the project secret HF_TOKEN,
# which needs write access to the storage bucket (see DEVELOPMENT.md).
HF_TOKEN=
